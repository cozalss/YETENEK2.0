# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Database setup (server-side only; never expose these in NEXT_PUBLIC_* vars)
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=<personal-access-token>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional AI reporting (rule-based fallback is used when omitted)
# ANTHROPIC_API_KEY=<anthropic-api-key>
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional vision-based validity judging (server-side only).
#
# Bu anahtar YOKSA sistem tam olarak çalışmaya devam eder: kural tabanlı hakem
# (src/infrastructure/validity/rule-based-judge.ts) cihazda, ücretsiz ve
# çevrimdışı çalışıyor ve protokol ihlallerinin çoğunu zaten yakalıyor.
# Görsel hakem yalnız NİTELİKSEL denetimi ekler — kol savurma, uçuşta diz
# çekme, kısmi hareket açıklığı. Yani bir bağımlılık değil, bir iyileştirme.
#
# Model kimliği: vision + strict structured outputs desteği modelden modele
# değişiyor. Kodda sabitlenmedi; buradan pin'leyin ve ilk kurulumdan sonra
# bir smoke-test ile doğrulayın (docs/ARCHITECTURE-V3.md §3.6).
# OPENAI_API_KEY=<openai-api-key>
# OPENAI_VISION_MODEL=gpt-5.6
